# Telegram Bot API Token (Get via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# NVIDIA NIM AI API Key (Supports Nemotron-3.5 & Moonshot Kimi-k3)
NVIDIA_API_KEY=nvapi-your_nvidia_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TEXT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_VISION_MODEL=moonshotai/kimi-k3

# Google Gemini API Key (Optional secondary engine)
GEMINI_API_KEY=your_gemini_api_key_here

# Admin Secret
ADMIN_SECRET=fossmbccet-super-secret-key

# Community Details
COMMUNITY_NAME=FOSS MBCCET
COMMUNITY_GITHUB=https://github.com/fossmbccet
COMMUNITY_WEBSITE=https://fossmbccet.org
COMMUNITY_TELEGRAM=https://t.me/fossmbccet
COLLEGE_NAME=Mar Baselios Christian College of Engineering and Technology (MBCCET)

# Web & Evaluator Server
HOST=0.0.0.0
PORT=8000
DEBUG=false
